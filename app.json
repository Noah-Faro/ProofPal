{
  "expo": {
    "name": "Scribe",
    "slug": "proofpal",
    "scheme": "proofpal",
    "version": "1.0.0",
    "platforms": ["ios"],
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": false,
      "bundleIdentifier": "com.proofpal.app",
      "infoPlist": {
        "UIRequiresFullScreen": false
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-status-bar",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      [
        "react-native-enriched-markdown",
        {
          "enableMath": true
        }
      ]
    ]
  }
}
